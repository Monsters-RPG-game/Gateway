{
  "name": "gateway",
  "version": "0.2.6",
  "description": "Main point of access for monsters microservice. This project is a REST API",
  "productName": "Gateway",
  "author": "https://github.com/Virus288",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "build/src/main.js",
  "scripts": {
    "start": "node --import ./node_modules/@monsters/metrics/lib/metrics.js --experimental-loader=@opentelemetry/instrumentation/hook.mjs build/src/main.js",
    "start:dev": "cross-env NODE_ENV=development nodemon --exec tsx src/main.ts",
    "start:testDev": "cross-env NODE_ENV=testDev node --import ./node_modules/@monsters/metrics/lib/metrics.js --experimental-loader=@opentelemetry/instrumentation/hook.mjs build/src/main.js",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "lint": "cross-env NODE_ENV=development eslint -c eslint.config.mjs . --fix --cache",
    "listErrors": "node_modules/.bin/tsc --skipLibCheck",
    "lintStaged": "npx lint-staged",
    "test": "echo 'If you want to run all the tests, please use makefile'",
    "test:e2e": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --config  __tests__/jest.config.e2e.ts",
    "test:db": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --config __tests__/jest.config.db.ts",
    "test:unit": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config __tests__/jest.config.unit.ts",
    "migrate": "node build/src/migrations/index.js",
    "migrate:dev": "cross-env NODE_ENV=development node build/src/migrations/index.js"
  },
  "lint-staged": {
    "*.ts": [
      "cross-env NODE_ENV=development eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ]
  },
  "dependencies": {
    "@monsters/metrics": "github:Monsters-RPG-game/Packages-metrics",
    "@monsters/utils": "github:Monsters-RPG-game/Packages-utils",
    "@monsters/validator": "github:Monsters-RPG-game/Packages-validator",
    "amqplib": "0.10.8",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "8.0.1",
    "express-session": "1.18.2",
    "helmet": "^8.0.0",
    "jose": "^6.0.7",
    "mongoose": "8.16.3",
    "redis": "^5.1.1",
    "simpl-loggar": "^0.7.0",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.2",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.9.0",
    "@jest/globals": "30.0.4",
    "@types/amqplib": "0.10.7",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/express-session": "1.18.2",
    "@types/node": "24.0.15",
    "@types/semver": "^7.5.8",
    "@types/supertest": "6.0.3",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.37.0",
    "@typescript-eslint/parser": "8.37.0",
    "cross-env": "7.0.3",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.0.1",
    "eslint-plugin-jsdoc": "^51.3.4",
    "eslint-plugin-prettier": "5.5.3",
    "eslint-plugin-sort-class-members": "1.21.0",
    "jest": "30.0.4",
    "moc-socket": "0.2.3",
    "mongodb-memory-server": "10.1.4",
    "nodemon": "3.1.10",
    "prettier": "3.6.2",
    "supertest": "7.1.3",
    "ts-jest": "29.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.3",
    "tsx": "^4.7.2",
    "typescript": "5.8.3"
  },
  "keywords": [
    "gateway",
    "monsters",
    "mode.js",
    "nodejs"
  ],
  "engines": {
    "node": ">=19"
  }
}
